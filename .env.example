# Copy to .env and fill in real values:  cp .env.example .env

# Personal access token from https://cloud.ouraring.com/personal-access-tokens
OURA_ACCESS_TOKEN=your-oura-personal-access-token

# Long random secret used to authenticate MCP clients.
# Generate one with:  openssl rand -hex 32
# Your connector URL becomes  https://<host>/mcp/<this value>
MCP_AUTH_TOKEN=generate-a-long-random-string

# Oura API request timeout in seconds (optional, default 30)
OURA_TIMEOUT=30

# Host port the server is published on (optional, default 8000)
OURA_MCP_PORT=8000

# Host interface to bind (optional, default 127.0.0.1 = this machine only).
# Set to 0.0.0.0 only if your reverse proxy or tunnel runs on another machine.
OURA_MCP_BIND=127.0.0.1
